# Supabase project connection.
# Get these from your Supabase project: Settings -> API.
#
# NEXT_PUBLIC_* values are safe to expose in the browser bundle (that's what
# NEXT_PUBLIC_ means) - they're the anon/publishable key, meant to be used
# alongside Row Level Security, not a secret by themselves.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - full read/write access, bypasses Row Level Security.
# Server-side only. NEVER prefix this with NEXT_PUBLIC_, never import it into
# a Client Component, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (Phase 5). The password is hashed before being stored/compared -
# this env var holds the hash, not the plaintext password. Session secret
# signs the admin session cookie.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
