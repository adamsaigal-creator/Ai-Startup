# Self-hosted Postgres connection (Phase 4A architecture).
# Point this at your own Postgres instance - on your DigitalOcean server in
# production, or a local/dev database while working on this locally.
# Never commit the real value.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Signs the admin session cookie (Phase 4B+ auth). Generate a real random
# value before any real deployment, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Admin login (Phase 4B+). The password is hashed (Argon2/bcrypt) before
# being stored/compared - this env var holds the hash, not the plaintext
# password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Legacy Supabase vars - rollback path only.
#
# The public site's data layer (lib/data/*.ts) now reads from DATABASE_URL
# above via Prisma, not Supabase. These are kept only so the earlier
# Supabase-backed implementation (lib/supabase/*.ts, supabase/) can still be
# restored if the Prisma/Postgres cutover needs to be reverted. Safe to
# delete once that rollback path is no longer needed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
