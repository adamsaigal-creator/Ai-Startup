# Production environment variables for the self-hosted Saigal Realty app.
# Copy this file to .env (local dev) or set these in your host's own
# environment/secrets configuration (production) - never commit real
# values. See docs/DEPLOYMENT.md for the full production setup procedure.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Self-hosted Postgres connection. Point this at your own Postgres instance -
# on your DigitalOcean server in production, or a local/dev database while
# working on this locally.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# ---------------------------------------------------------------------------
# Admin authentication (required)
# ---------------------------------------------------------------------------
# HMAC key session tokens are hashed with before storage (see
# lib/auth/session.ts) - rotating this value instantly invalidates every
# existing admin session. Generate a real random value before any real
# deployment, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Admin login. The password is hashed with Argon2id, then the whole hash is
# Base64-encoded before being stored here - this env var holds neither the
# plaintext password nor the raw Argon2 hash. Base64-encoding avoids the raw
# hash's literal `$` delimiters, which proved unreliable to carry through a
# .env file unmangled across environments/loaders.
# Generate it with: npx tsx scripts/hash-password.ts "your-password"
# (paste its output into your .env file exactly as printed.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=

# ---------------------------------------------------------------------------
# Media storage (required in production)
# ---------------------------------------------------------------------------
# Absolute filesystem path where uploaded images (from /admin/media) are
# written and read back from - see lib/media/storage.ts and
# app/media/[...path]/route.ts. Never a third-party storage service, and
# never a path inside this app's own deploy directory (.next, a temp dir,
# the git checkout itself, etc.) - anything under a rebuilt/redeployed path
# is wiped on the next deploy.
#
# Local dev example (do not commit a real machine-specific path - this is
# just an example):
#   MEDIA_STORAGE_PATH=/Users/you/Ai-Startup/storage/uploads
# DigitalOcean production example - a sibling directory outside the app's
# git checkout, so it survives `git pull` / redeploy. This is the directory
# to back up (see docs/DEPLOYMENT.md):
#   MEDIA_STORAGE_PATH=/var/www/saigalrealty-data/uploads
# If unset, lib/media/storage.ts falls back to ./storage/uploads relative
# to the project directory - convenient for local dev only. Production must
# always set this explicitly, outside the deploy directory.
MEDIA_STORAGE_PATH=

# ---------------------------------------------------------------------------
# Runtime (production)
# ---------------------------------------------------------------------------
# Next.js's own convention - set by `next start` implicitly in most setups,
# but PM2/systemd process managers should set this explicitly. Controls the
# session cookie's Secure flag (lib/auth/cookies.ts) and Next.js's own
# production optimizations/error-detail suppression.
NODE_ENV=production

# The site's own public origin, no trailing slash - used for canonical
# URLs, Open Graph tags, sitemap.xml, and robots.txt (see
# lib/seo/site-url.ts). Optional: falls back to https://saigalrealty.ca in
# production and http://localhost:3000 in dev, so this only needs setting
# for a staging/preview deployment on a different domain.
SITE_URL=https://saigalrealty.ca
