# Self-hosted Postgres connection (Phase 4A architecture).
# Point this at your own Postgres instance - on your DigitalOcean server in
# production, or a local/dev database while working on this locally.
# Never commit the real value.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Also used as the HMAC key session tokens are hashed with before storage
# (see lib/auth/session.ts) - rotating this value instantly invalidates
# every existing admin session. Generate a real random value before any
# real deployment, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Admin login. The password is hashed with Argon2id, then the whole hash
# is Base64-encoded before being stored here - this env var holds neither
# the plaintext password nor the raw Argon2 hash. Base64-encoding avoids
# the raw hash's literal `$` delimiters, which proved unreliable to carry
# through a .env file unmangled across environments/loaders.
# Generate it with: npx tsx scripts/hash-password.ts "your-password"
# (paste its output into your .env file exactly as printed.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=

# Self-hosted media storage (Phase 4F). Absolute filesystem path where
# uploaded images (from /admin/media) are written and read back from - see
# lib/media/storage.ts and app/media/[...path]/route.ts. Never a
# third-party storage service, and never a path inside this app's own
# build/deploy directory (.next, a temp dir, etc.) - anything under a
# rebuilt/redeployed path is wiped on the next deploy.
#
# Local dev example (this repo's own directory - do not commit a real
# machine-specific path; this is just an example):
#   MEDIA_STORAGE_PATH=/Users/you/Ai-Startup/storage/uploads
# DigitalOcean production example (outside the app's deploy directory, so
# it survives `git pull` / redeploy - this is the directory to back up):
#   MEDIA_STORAGE_PATH=/var/www/saigalrealty/uploads
# If unset, lib/media/storage.ts falls back to ./storage/uploads relative
# to the project directory - convenient for local dev, but production
# should always set this explicitly.
MEDIA_STORAGE_PATH=

# ---------------------------------------------------------------------------
# Legacy Supabase vars - rollback path only.
#
# The public site's data layer (lib/data/*.ts) now reads from DATABASE_URL
# above via Prisma, not Supabase. These are kept only so the earlier
# Supabase-backed implementation (lib/supabase/*.ts, supabase/) can still be
# restored if the Prisma/Postgres cutover needs to be reverted. Safe to
# delete once that rollback path is no longer needed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
